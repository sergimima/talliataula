# URL pública del web (sin barra final)
NEXT_PUBLIC_SITE_URL=https://talliataula.com

# Envío del formulario de presupuesto con Resend (https://resend.com)
RESEND_API_KEY=
# Dónde llegan las solicitudes (puede ser una lista separada por comas)
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "Tall i a Taula <web@talliataula.com>"
CONTACT_FROM_EMAIL=

# Datos legales del titular (aviso legal y privacidad).
# Opcionales: los datos del titular ya están en src/config/site.ts; estas variables solo los sobrescriben.
NEXT_PUBLIC_TITULAR_NOMBRE=
NEXT_PUBLIC_TITULAR_NIF=
NEXT_PUBLIC_TITULAR_DOMICILIO=
NEXT_PUBLIC_CONTACTE_EMAIL=

# Estadísticas (Umami). ID de la web que da el panel de Umami al darla de alta.
# Se lee en el build: después de ponerlo hay que reconstruir la imagen.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Solo si Umami no está en el mismo docker compose (por defecto http://umami:3000)
# UMAMI_INTERNAL_URL=
