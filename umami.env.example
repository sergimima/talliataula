# Copiar a umami.env (no se sube a git) y rellenar con valores aleatorios.
# La contraseña de POSTGRES_PASSWORD debe ser la misma que va dentro de DATABASE_URL.
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://umami:CONTRASEÑA@umami-db:5432/umami
# openssl rand -hex 32
APP_SECRET=
# openssl rand -hex 32 (necesario para la verificación en dos pasos del panel)
TWO_FACTOR_ENCRYPTION_KEY=
